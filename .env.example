# Copy to .env and use: node --env-file=.env server/index.js
# npm run dev also reads .env on the backend automatically.
PORT=3001
LLM_PROVIDER=demo
# To enable real AI chat AND semantic embeddings, use LLM_PROVIDER=openai.
CORTEX_AI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
# Optional. Generated and stored locally if absent. Set a strong secret in deployment.
JWT_SECRET=
# Demo seed accounts are development-only by default. Never enable on public deployments.
SEED_DEMO=true
